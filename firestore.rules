rules_version = '2';

// 모바일 청첩장 Firestore 보안 규칙 — 결혼식 종료(2026-06-20) 후 작성 마감 상태
// - guestbook(방명록): 열람(read)만 가능. 작성/수정/삭제 모두 불가.
// - rsvp(참석의사): 모든 클라이언트 접근 불가 (관리자는 Admin SDK로 우회).
// - 그 외 모든 경로: 기본 거부(default deny).
// 신규 작성을 다시 받으려면 guestbook.create / rsvp.create 규칙을 복구할 것
// (직전 검증 룰은 git history d63f139 의 firestore.rules 참고).

service cloud.firestore {
  match /databases/{database}/documents {

    match /guestbook/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /rsvp/{docId} {
      allow read, create, update, delete: if false;
    }
  }
}
